@page "/admin/users"
@layout AdminLayout
@rendermode InteractiveServer
@inject todolist.Services.UserService UserService
@inject NavigationManager Navigation

<div class="container-fluid p-0 pb-5">

    <!-- Top Header Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-dark mb-1 fs-3">User Management</h2>
                <p class="text-muted small mb-0">Manage system users, roles, and access permissions.</p>
            </div>
            <button class="btn text-white px-4 py-2 rounded-pill fw-semibold shadow-sm" style="background-color: #0d3b66;" @onclick="OpenAddUserModal">
                + Add New User
            </button>
        </div>
    </div>

    <!-- Search & Filter Bar Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="input-group bg-light rounded-pill border px-3 py-1">
                    <span class="input-group-text bg-transparent border-0 text-muted ps-0">🔍</span>
                    <input type="text"
                           class="form-control bg-transparent border-0 shadow-none ps-2"
                           placeholder="Search by name, email or role..."
                           @bind="searchInput"
                           @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select bg-light rounded-pill border py-2 px-3 shadow-none text-muted" @bind="selectedRoleFilter">
                    <option value="">All Roles</option>
                    <option value="Admin">Admin</option>
                    <option value="User">User</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button class="btn text-white px-4 py-2 rounded-pill fw-semibold w-100 shadow-sm" style="background-color: #0d3b66;" @onclick="ExecuteSearch">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Users List Table Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-1">Users List</h5>
                <p class="text-muted small mb-0">View and manage all system users.</p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5 text-muted fst-italic">Loading users...</div>
        }
        else if (filteredList == null || !filteredList.Any())
        {
            <div class="text-center py-5 bg-light rounded-3 border border-dashed mt-2">
                <p class="text-muted mb-0 fw-medium">
                    No user exists matching "@activeSearchTerm" @(string.IsNullOrEmpty(selectedRoleFilter) ? "" : $" with role '{selectedRoleFilter}'").
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="text-muted small border-bottom">
                            <th class="py-3 ps-3">#</th>
                            <th class="py-3">Name</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Department</th>
                            <th class="py-3">Role</th>
                            <th class="py-3">MFA Status</th>
                            <th class="py-3 text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = (currentPage - 1) * pageSize + 1;
                        }
                        @foreach (var user in PaginatedList)
                        {
                            <tr @key="user.Id" class="border-bottom">
                                <td class="py-3 ps-3 text-muted small fw-semibold">@(index++)</td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 35px; height: 35px; background-color: #0d3b66; font-size: 0.85rem;">
                                            @(GetInitial(user))
                                        </div>
                                        <span class="fw-semibold text-dark">
                                            @(string.IsNullOrWhiteSpace(user.Name) ? user.Email?.Split('@')[0] : user.Name)
                                        </span>
                                    </div>
                                </td>
                                <td class="py-3 text-muted small">@user.Email</td>
                                <td class="py-3 text-muted small">@(string.IsNullOrEmpty(user.Department) ? "N/A" : user.Department)</td>
                                <td class="py-3">
                                    <span class="badge @(user.Role == "Admin" ? "bg-danger bg-opacity-10 text-danger" : "bg-secondary bg-opacity-10 text-secondary") px-3 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="py-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               id="@($"mfaSwitch_{user.Id}")"
                                               checked="@user.IsMfaEnabled"
                                               @onchange="(e) => ToggleMfaStatusAsync(user, e)"
                                               style="cursor: pointer;" />
                                        <label class="form-check-label small fw-medium @(user.IsMfaEnabled ? "text-success" : "text-muted")" for="@($"mfaSwitch_{user.Id}")">
                                            @(user.IsMfaEnabled ? "Enabled" : "Disabled")
                                        </label>
                                    </div>
                                </td>
                                <td class="py-3 text-end pe-3">
                                    <button class="btn btn-sm btn-light border text-primary shadow-sm me-1 rounded-2 px-2 py-1" title="Edit" @onclick="() => OpenEditUserModal(user)">
                                        ✏️
                                    </button>
                                    <button class="btn btn-sm btn-light border text-danger shadow-sm rounded-2 px-2 py-1" title="Delete" @onclick="() => OpenDeleteModal(user)">
                                        🗑️
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-2 text-muted small">
                <span>
                    Showing @(filteredList.Any() ? (currentPage - 1) * pageSize + 1 : 0)
                    to @Math.Min(currentPage * pageSize, filteredList.Count())
                    of @filteredList.Count() users
                </span>

                <div class="btn-group gap-1">
                    <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill"
                            @onclick="() => ChangePage(currentPage - 1)"
                            disabled="@(currentPage == 1)">
                        Previous
                    </button>

                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNum = i;
                        <button class="btn btn-sm @(currentPage == pageNum ? "text-white fw-bold shadow-sm" : "btn-outline-secondary") px-3 rounded-pill"
                                style="@(currentPage == pageNum ? "background-color: #0d3b66; border-color: #0d3b66;" : "")"
                                @onclick="() => ChangePage(pageNum)">
                            @pageNum
                        </button>
                    }

                    <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill"
                            @onclick="() => ChangePage(currentPage + 1)"
                            disabled="@(currentPage == TotalPages)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Overlay for Add/Edit User -->
@if (showUserModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="card border-0 shadow-lg rounded-4 p-4 bg-white" style="width: 420px; max-width: 90%;">
            <h3 class="fw-bold text-dark fs-5 mb-3">@(isEditMode ? "Edit User" : "Add New User")</h3>

            <div class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label small fw-semibold text-muted mb-1">Name</label>
                    <input type="text" class="form-control rounded-3" @bind="activeUser.Name" />
                </div>
                <div>
                    <label class="form-label small fw-semibold text-muted mb-1">Email</label>
                    <input type="email" class="form-control rounded-3" @bind="activeUser.Email" />
                </div>
                <div>
                    <label class="form-label small fw-semibold text-muted mb-1">Department</label>
                    <input type="text" class="form-control rounded-3" @bind="activeUser.Department" />
                </div>
                <div>
                    <label class="form-label small fw-semibold text-muted mb-1">Role</label>
                    <select class="form-select rounded-3" @bind="activeUser.Role">
                        <option value="User">User</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="modalMfaToggle" @bind="modalMfaValue" style="cursor: pointer;" />
                    <label class="form-check-label small fw-semibold text-dark" for="modalMfaToggle">Enable Multi-Factor Authentication (MFA)</label>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-light border px-4 py-2 rounded-pill fw-semibold text-muted" @onclick="CloseUserModal">Cancel</button>
                <button class="btn text-white px-4 py-2 rounded-pill fw-semibold" style="background-color: #0d3b66;" @onclick="SaveUserAsync">Save Changes</button>
            </div>
        </div>
    </div>
}

<!-- Modal Overlay for Delete Confirmation -->
@if (showDeleteModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="card border-0 shadow-lg rounded-4 p-4 bg-white" style="width: 380px; max-width: 90%;">
            <h3 class="fw-bold text-danger fs-5 mb-2">Confirm Delete</h3>
            <p class="text-muted small mb-4">Are you sure you want to delete <strong>@(userToDelete?.Name ?? userToDelete?.Email)</strong>?</p>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-light border px-4 py-2 rounded-pill fw-semibold text-muted" @onclick="CloseDeleteModal">Cancel</button>
                <button class="btn btn-danger px-4 py-2 rounded-pill fw-semibold" @onclick="ConfirmDeleteAsync">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<todolist.Models.User> userList = new();
    private List<todolist.Models.User> filteredList = new();

    private string searchInput = "";
    private string activeSearchTerm = "";
    private string selectedRoleFilter = "";
    private bool isLoading = true;

    private int currentPage = 1;
    private int pageSize = 5;

    private bool showUserModal = false;
    private bool showDeleteModal = false;
    private bool isEditMode = false;

    private todolist.Models.User activeUser = new();
    private todolist.Models.User? userToDelete;
    private bool modalMfaValue = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        userList = await UserService.GetAllUsersAsync() ?? new List<todolist.Models.User>();
        ExecuteSearch();
        isLoading = false;
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filteredList.Count() / pageSize));

    private IEnumerable<todolist.Models.User> PaginatedList => filteredList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            currentPage = newPage;
        }
    }

    private void ExecuteSearch()
    {
        activeSearchTerm = searchInput.Trim();

        filteredList = userList.Where(u =>
            (string.IsNullOrWhiteSpace(activeSearchTerm) ||
             (!string.IsNullOrEmpty(u.Name) && u.Name.Contains(activeSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
             (!string.IsNullOrEmpty(u.Email) && u.Email.Contains(activeSearchTerm, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrWhiteSpace(selectedRoleFilter) || string.Equals(u.Role, selectedRoleFilter, StringComparison.OrdinalIgnoreCase))
        ).ToList();

        currentPage = 1;
        StateHasChanged();
    }

    private string GetInitial(todolist.Models.User user)
    {
        var identifier = !string.IsNullOrWhiteSpace(user.Name) ? user.Name : user.Email;
        return !string.IsNullOrWhiteSpace(identifier) ? identifier[0].ToString().ToUpper() : "U";
    }

    // Toggle Handler for MFA Switch
    private async Task ToggleMfaStatusAsync(todolist.Models.User user, ChangeEventArgs e)
    {
        if (user != null && e.Value is bool newStatus)
        {
            user.IsMfaEnabled = newStatus;

            // Direct database update call
            await UserService.UpdateUserAsync(user);

            // Re-render to update the "Enabled"/"Disabled" text and switch visual state
            StateHasChanged();
        }
    }

    private void OpenAddUserModal()
    {
        isEditMode = false;
        activeUser = new todolist.Models.User { Role = "User", IsMfaEnabled = false };
        modalMfaValue = false;
        showUserModal = true;
    }

    private void OpenEditUserModal(todolist.Models.User user)
    {
        isEditMode = true;
        activeUser = new todolist.Models.User
        {
            Id = user.Id,
            Name = user.Name,
            Email = user.Email,
            Department = user.Department,
            Role = user.Role,
            PasswordHash = user.PasswordHash,
            IsMfaEnabled = user.IsMfaEnabled,
            MfaVerified = user.MfaVerified
        };

        modalMfaValue = user.IsMfaEnabled;
        showUserModal = true;
    }

    private void CloseUserModal()
    {
        showUserModal = false;
        activeUser = new();
    }

    private async Task SaveUserAsync()
    {
        activeUser.IsMfaEnabled = modalMfaValue;

        if (isEditMode)
        {
            await UserService.UpdateUserAsync(activeUser);
        }
        else
        {
            await UserService.AddUserAsync(activeUser);
        }

        CloseUserModal();
        await LoadUsers();
    }

    private void OpenDeleteModal(todolist.Models.User user)
    {
        userToDelete = user;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        userToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (userToDelete != null)
        {
            await UserService.DeleteUserAsync(userToDelete.Id);
            CloseDeleteModal();
            await LoadUsers();
        }
    }
}