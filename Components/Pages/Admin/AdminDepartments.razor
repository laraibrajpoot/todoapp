@page "/admin/departments"
@layout AdminLayout
@rendermode InteractiveServer
@inject todolist.Services.DepartmentService DepartmentService
@inject todolist.Services.UserService UserService
@inject todolist.Services.TaskService TaskService

<div class="container-fluid p-0 pb-5">

    <!-- Top Header Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-dark mb-1 fs-3">Departments Management</h2>
                <p class="text-muted small mb-0">Manage departments and their assigned members.</p>
            </div>
            <button class="btn text-white px-4 py-2 rounded-pill fw-semibold shadow-sm" style="background-color: #0d3b66;" @onclick="OpenAddModal">
                + Add New Department
            </button>
        </div>
    </div>

    <!-- Search Bar Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <div class="row g-3 align-items-center">
            <div class="col-md-9">
                <div class="input-group bg-light rounded-pill border px-3 py-1">
                    <span class="input-group-text bg-transparent border-0 text-muted ps-0">🔍</span>
                    <input type="text"
                           class="form-control bg-transparent border-0 shadow-none ps-2"
                           placeholder="Search departments..."
                           @bind="searchTerm"
                           @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-3 text-end">
                <button class="btn text-white px-4 py-2 rounded-pill fw-semibold w-100 shadow-sm" style="background-color: #0d3b66;" @onclick="ExecuteSearch">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Departments List Table Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-1">Departments List</h5>
                <p class="text-muted small mb-0">View all departments and member allocations.</p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5 text-muted fst-italic">Loading departments...</div>
        }
        else if (!FilteredDepartments.Any())
        {
            <div class="text-center py-5 bg-light rounded-3 border border-dashed mt-2">
                <p class="text-muted mb-0 fw-medium">No departments found matching your query.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="text-muted small border-bottom">
                            <th class="py-3 ps-3" style="width: 60px;">#</th>
                            <th class="py-3">Department Name</th>
                            <th class="py-3">Members</th>
                            <th class="py-3">Description</th>
                            <th class="py-3 text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = (currentPage - 1) * pageSize + 1;
                        }
                        @foreach (var dept in PaginatedDepartments)
                        {
                            <tr class="border-bottom">
                                <td class="py-3 ps-3 text-muted small fw-semibold">@(index++)</td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 40px; height: 40px; background-color: #0d3b66; font-size: 1.1rem;">
                                            🏢
                                        </div>
                                        <div>
                                            <span class="fw-semibold text-dark d-block">@dept.Name</span>
                                            <span class="text-muted" style="font-size: 0.75rem;">Active Tasks: @dept.ActiveTaskCount</span>
                                        </div>
                                    </div>
                                </td>
                                <!-- Member Full Name Badges Column -->
                                <td class="py-3">
                                    @{
                                        var assignedUsers = availableUsers.Where(u => string.Equals(u.Department, dept.Name, StringComparison.OrdinalIgnoreCase)).ToList();
                                    }
                                    @if (!assignedUsers.Any())
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1 rounded-pill" style="font-size: 0.75rem;">0 Members</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            @foreach (var user in assignedUsers)
                                            {
                                                <div class="d-inline-flex align-items-center bg-light border rounded-pill px-2 py-1 shadow-sm" title="@user.Email">
                                                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold me-1"
                                                         style="width: 22px; height: 22px; background-color: #0d3b66; font-size: 0.65rem;">
                                                        @GetInitial(user)
                                                    </div>
                                                    <span class="text-dark small fw-medium pe-1" style="font-size: 0.75rem;">@user.Name</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="py-3 text-muted small" style="max-width: 250px;">
                                    @(string.IsNullOrWhiteSpace(dept.Description) ? "No description provided." : dept.Description)
                                </td>
                                <td class="py-3 text-end pe-3">
                                    <button class="btn btn-sm btn-light border text-primary shadow-sm me-1 rounded-2 px-2 py-1" title="Edit" @onclick="() => OpenEditModal(dept)">
                                        ✏️
                                    </button>
                                    <button class="btn btn-sm btn-light border text-danger shadow-sm rounded-2 px-2 py-1" title="Remove" @onclick="() => OpenDeleteModal(dept)">
                                        🗑️
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Dynamic Pagination Footer -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-2 text-muted small">
                <span>
                    Showing @(FilteredDepartments.Any() ? (currentPage - 1) * pageSize + 1 : 0)
                    to @Math.Min(currentPage * pageSize, FilteredDepartments.Count())
                    of @FilteredDepartments.Count() departments
                </span>

                <div class="btn-group gap-1">
                    <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill"
                            @onclick="() => ChangePage(currentPage - 1)"
                            disabled="@(currentPage == 1)">
                        Previous
                    </button>

                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNum = i;
                        <button class="btn btn-sm @(currentPage == pageNum ? "text-white fw-bold shadow-sm" : "btn-outline-secondary") px-3 rounded-pill"
                                style="@(currentPage == pageNum ? "background-color: #0d3b66; border-color: #0d3b66;" : "")"
                                @onclick="() => ChangePage(pageNum)">
                            @pageNum
                        </button>
                    }

                    <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill"
                            @onclick="() => ChangePage(currentPage + 1)"
                            disabled="@(currentPage == TotalPages)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add / Edit Department Modal -->
@if (showFormModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="card border-0 shadow-lg rounded-4 p-4 bg-white" style="width: 420px; max-width: 90%;">
            <h3 class="fw-bold text-dark fs-5 mb-3">@(editingId.HasValue ? "Edit Department" : "Add New Department")</h3>

            <div class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label small fw-semibold text-muted mb-1">Department Name *</label>
                    <input type="text" class="form-control rounded-3" @bind="activeDepartment.Name" placeholder="e.g. Software Engineering" />
                </div>
                <div>
                    <label class="form-label small fw-semibold text-muted mb-1">Description</label>
                    <textarea class="form-control rounded-3" @bind="activeDepartment.Description" placeholder="Short department scope or details..." style="height: 80px; resize: none;"></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-light border px-4 py-2 rounded-pill fw-semibold text-muted" @onclick="CloseFormModal">Cancel</button>
                <button class="btn text-white px-4 py-2 rounded-pill fw-semibold" style="background-color: #0d3b66;" @onclick="SaveDepartmentAsync">Save</button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="card border-0 shadow-lg rounded-4 p-4 bg-white" style="width: 380px; max-width: 90%;">
            <h3 class="fw-bold text-danger fs-5 mb-2">Confirm Removal</h3>

            @if (departmentToDelete != null && departmentToDelete.MemberCount > 0)
            {
                <p class="text-muted small mb-4">
                    Cannot delete <strong>@departmentToDelete.Name</strong> because it has <strong>@departmentToDelete.MemberCount assigned member(s)</strong>. Please reassign members in User Management first.
                </p>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-light border px-4 py-2 rounded-pill fw-semibold text-muted" @onclick="CloseDeleteModal">Close</button>
                </div>
            }
            else
            {
                <p class="text-muted small mb-4">Are you sure you want to delete <strong>@departmentToDelete?.Name</strong>?</p>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-light border px-4 py-2 rounded-pill fw-semibold text-muted" @onclick="CloseDeleteModal">Cancel</button>
                    <button class="btn btn-danger px-4 py-2 rounded-pill fw-semibold" @onclick="ConfirmDeleteAsync">Confirm Delete</button>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<DepartmentViewModel> departments = new();
    private List<todolist.Models.User> availableUsers = new();

    private string searchTerm = string.Empty;
    private string activeSearchQuery = string.Empty;
    private bool isLoading = true;

    // Pagination State
    private int currentPage = 1;
    private int pageSize = 5; // Change this number to show more/fewer departments per page

    private bool showFormModal = false;
    private bool showDeleteModal = false;
    private int? editingId = null;

    private DepartmentViewModel activeDepartment = new();
    private DepartmentViewModel? departmentToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;

        var rawDepartments = await DepartmentService.GetAllDepartmentsAsync() ?? new List<todolist.Models.Department>();
        availableUsers = await UserService.GetAllUsersAsync() ?? new List<todolist.Models.User>();
        var rawTasks = await TaskService.GetAllTasksAsync() ?? new List<todolist.Models.TaskItem>();

        var userDepartmentNames = availableUsers
            .Where(u => !string.IsNullOrWhiteSpace(u.Department))
            .Select(u => u.Department.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var combinedDepartmentNames = rawDepartments
            .Select(d => d.Name.Trim())
            .Union(userDepartmentNames, StringComparer.OrdinalIgnoreCase)
            .ToList();

        departments = combinedDepartmentNames.Select((deptName, index) =>
        {
            var existingDept = rawDepartments.FirstOrDefault(d => string.Equals(d.Name, deptName, StringComparison.OrdinalIgnoreCase));

            return new DepartmentViewModel
            {
                Id = existingDept?.Id ?? (index + 1),
                Name = existingDept?.Name ?? deptName,
                Description = existingDept?.Description ?? "Created via User Profile",
                MemberCount = availableUsers.Count(u => string.Equals(u.Department, deptName, StringComparison.OrdinalIgnoreCase)),
                ActiveTaskCount = rawTasks.Count(t => string.Equals(t.Department, deptName, StringComparison.OrdinalIgnoreCase) && !string.Equals(t.Status, "Completed", StringComparison.OrdinalIgnoreCase))
            };
        }).ToList();

        isLoading = false;
        StateHasChanged();
    }

    private IEnumerable<DepartmentViewModel> FilteredDepartments =>
        departments.Where(d =>
            string.IsNullOrWhiteSpace(activeSearchQuery) ||
            d.Name.Contains(activeSearchQuery, StringComparison.OrdinalIgnoreCase)
        );

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredDepartments.Count() / pageSize));

    private IEnumerable<DepartmentViewModel> PaginatedDepartments => FilteredDepartments
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            currentPage = newPage;
        }
    }

    private void ExecuteSearch()
    {
        activeSearchQuery = searchTerm.Trim();
        currentPage = 1; // Reset back to page 1 on search
    }

    private string GetInitial(todolist.Models.User user)
    {
        var identifier = !string.IsNullOrWhiteSpace(user.Name) ? user.Name : user.Email;
        return !string.IsNullOrWhiteSpace(identifier) ? identifier[0].ToString().ToUpper() : "U";
    }

    private void OpenAddModal()
    {
        editingId = null;
        activeDepartment = new DepartmentViewModel();
        showFormModal = true;
    }

    private void OpenEditModal(DepartmentViewModel dept)
    {
        editingId = dept.Id;
        activeDepartment = new DepartmentViewModel
        {
            Id = dept.Id,
            Name = dept.Name,
            Description = dept.Description,
            MemberCount = dept.MemberCount,
            ActiveTaskCount = dept.ActiveTaskCount
        };
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
        activeDepartment = new();
    }

    private async Task SaveDepartmentAsync()
    {
        if (string.IsNullOrWhiteSpace(activeDepartment.Name))
            return;

        var domainDepartment = new todolist.Models.Department
        {
            Id = activeDepartment.Id,
            Name = activeDepartment.Name.Trim(),
            Description = activeDepartment.Description?.Trim() ?? string.Empty
        };

        if (editingId.HasValue)
        {
            await DepartmentService.UpdateDepartmentAsync(domainDepartment);
        }
        else
        {
            await DepartmentService.AddDepartmentAsync(domainDepartment);
        }

        CloseFormModal();
        await LoadDataAsync();
    }

    private void OpenDeleteModal(DepartmentViewModel dept)
    {
        departmentToDelete = dept;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        departmentToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (departmentToDelete != null && departmentToDelete.MemberCount == 0)
        {
            await DepartmentService.DeleteDepartmentAsync(departmentToDelete.Id);
            CloseDeleteModal();
            await LoadDataAsync();
        }
    }

    public class DepartmentViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int MemberCount { get; set; }
        public int ActiveTaskCount { get; set; }
    }
}