@page "/admin/notifications"
@layout AdminLayout
@using todolist.Models
@using todolist.Services

@rendermode InteractiveServer

@inject TaskService TaskService
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<div class="px-4 py-3" style="min-height: 85vh; padding-bottom: 80px !important;">
    <!-- Banner Header Section -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);">
        <div class="d-flex justify-content-between align-items-center position-relative" style="z-index: 2;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-white text-primary shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
                    🔔
                </div>
                <div>
                    <h2 class="fw-bold m-0 text-dark" style="font-size: 1.5rem;">Admin Notifications</h2>
                    <p class="text-muted m-0 mt-1" style="font-size: 0.9rem;">Review task deletion requests from users.</p>
                </div>
            </div>
            <div class="d-none d-md-flex align-items-center text-primary" style="font-size: 2.5rem; opacity: 0.8;">
                📨
            </div>
        </div>
    </div>

    <!-- Filter and Search Bar -->
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="input-group bg-white rounded-3 shadow-sm border" style="overflow: hidden;">
                <span class="input-group-text bg-white border-0 ps-3 text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                </span>
                <input type="text" class="form-control border-0 shadow-none py-2" placeholder="Search by username or task title..." @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="input-group bg-white rounded-3 shadow-sm border">
                <span class="input-group-text bg-white border-0 text-muted ps-3">📅</span>
                <select class="form-select bg-white border-0 shadow-none py-2" @bind="selectedDateFilter">
                    <option value="Select Date Range">Select Date Range</option>
                    <option value="Today">Today</option>
                    <option value="This Week">This Week</option>
                    <option value="This Month">This Month</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="input-group bg-white rounded-3 shadow-sm border">
                <span class="input-group-text bg-white border-0 text-muted ps-3">🔍</span>
                <select class="form-select bg-white border-0 shadow-none py-2" @bind="selectedStatusFilter">
                    <option value="All Statuses">All Statuses</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn btn-light border bg-white text-muted rounded-3 shadow-sm py-2 px-1" title="Clear Filters" @onclick="ClearFilters">
                🔄
            </button>
        </div>
    </div>

    <!-- Notifications Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0 border-0">
                    <thead>
                        <tr class="text-muted border-bottom" style="font-size: 0.85rem;">
                            <th class="border-0 pb-3" style="width: 40px;"><input type="checkbox" class="form-check-input" /></th>
                            <th class="border-0 pb-3" style="width: 60px;">#</th>
                            <th class="border-0 pb-3">Username</th>
                            <th class="border-0 pb-3">Task Title</th>
                            <th class="border-0 pb-3">Requested Date</th>
                            <th class="border-0 pb-3">Status</th>
                            <th class="border-0 pb-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredRequests == null || !FilteredRequests.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 border-0">
                                    <div class="py-4">
                                        <div class="mb-3 text-primary" style="font-size: 3rem; opacity: 0.7;">🔔</div>
                                        <h5 class="fw-bold text-dark mb-1">No Pending Notification Requests</h5>
                                        <p class="text-muted small mb-0">You're all caught up! There are no pending notification requests at the moment.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = 1;
                            @foreach (var req in FilteredRequests)
                            {
                                <tr class="border-bottom border-light">
                                    <td class="border-0"><input type="checkbox" class="form-check-input" /></td>
                                    <td class="text-muted border-0 fw-medium">@index</td>
                                    <td class="fw-bold text-dark border-0">@req.UserName</td>
                                    <td class="border-0 text-dark">@req.TaskTitle</td>
                                    <td class="text-muted border-0">@req.RequestedAt.ToString("MMM d, yyyy")</td>
                                    <td class="border-0">
                                        <span class="badge rounded-pill bg-warning bg-opacity-20 text-warning-emphasis px-3 py-2 fw-medium">
                                            ● Pending Approval
                                        </span>
                                    </td>
                                    <td class="text-end border-0">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button class="btn btn-sm btn-success px-3 fw-semibold rounded-2 shadow-sm" @onclick="() => HandleApproval(req, true)">Yes</button>
                                            <button class="btn btn-sm btn-danger px-3 fw-semibold rounded-2 shadow-sm" @onclick="() => HandleApproval(req, false)">No</button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer Pagination Bar -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <div class="text-muted small">
                    Showing 1 to @(FilteredRequests?.Count() ?? 0) of @(FilteredRequests?.Count() ?? 0) requests
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm bg-white text-muted rounded-pill px-3 py-1 border shadow-sm" disabled>Previous</button>
                    <button type="button" class="btn btn-sm px-3 py-1 rounded-pill fw-bold text-white shadow-sm" style="background-color: #0f172a;">1</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm bg-white text-muted rounded-pill px-3 py-1 border shadow-sm" disabled>Next</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TaskDeletionRequestModel> deletionRequests = new();
    private string searchTerm = "";
    private string selectedDateFilter = "Select Date Range";
    private string selectedStatusFilter = "All Statuses";

    private IEnumerable<TaskDeletionRequestModel> FilteredRequests => deletionRequests
        .GroupBy(r => r.TaskId)
        .Select(g => g.First())
        .Where(r => (string.IsNullOrWhiteSpace(searchTerm) || 
                     r.UserName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
                     r.TaskTitle.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
                    (selectedStatusFilter == "All Statuses" || selectedStatusFilter == "Pending"));

    protected override async Task OnInitializedAsync()
    {
        await LoadRequestsAsync();
    }

    private async Task LoadRequestsAsync()
    {
        deletionRequests = await NotificationService.GetPendingDeletionRequestsAsync();
    }

    private async Task HandleApproval(TaskDeletionRequestModel request, bool approve)
    {
        if (approve)
        {
            await TaskService.DeleteTaskAsync(request.TaskId);
        }

        // Pass title and message parameters separately to match CreateNotificationAsync signature
        if (request.UserId > 0)
        {
            var title = approve ? "Deletion Request Approved" : "Deletion Request Denied";
            var message = approve
                ? $"Your deletion request for task '{request.TaskTitle}' was approved."
                : $"Your deletion request for task '{request.TaskTitle}' was denied.";

            await NotificationService.CreateNotificationAsync(request.UserId, title, message);
        }

        await NotificationService.ResolveDeletionRequestAsync(request.Id);
        await LoadRequestsAsync();
    }

    private void ClearFilters()
    {
        searchTerm = "";
        selectedDateFilter = "Select Date Range";
        selectedStatusFilter = "All Statuses";
    }
}