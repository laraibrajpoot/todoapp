@page "/admin/profile"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@using System.IO
@inject AuthenticationStateProvider AuthStateProvider
@inject todolist.Services.UserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container-fluid px-4 py-4" style="max-width: 1050px;">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">Admin Profile Settings</h2>
        <p class="text-muted small">Manage your account information, credentials, and profile picture.</p>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>Success!</strong> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>Error!</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Profile Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 bg-white">
                <div class="position-relative d-inline-block mx-auto mb-3 mt-2">
                    @if (!string.IsNullOrWhiteSpace(adminProfilePic))
                    {
                        <img src="@adminProfilePic" alt="Admin Profile" class="rounded-circle object-fit-cover shadow-sm" style="width: 110px; height: 110px; border: 3px solid #0d3b66;" />
                    }
                    else
                    {
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm mx-auto" style="width: 110px; height: 110px; font-size: 2.5rem; background-color: #0d3b66;">
                            @GetAdminInitial()
                        </div>
                    }
                </div>

                <h5 class="fw-bold text-dark mb-1">@adminName</h5>
                <p class="text-muted small mb-3">@(string.IsNullOrEmpty(adminRole) ? "Admin" : adminRole)</p>

                <div class="text-start bg-light p-3 rounded-3 mb-3 small">
                    <div class="mb-2 text-truncate">
                        <span class="text-muted me-2">✉️</span> <span class="text-dark fw-medium">@adminEmail</span>
                    </div>
                    <div>
                        <span class="text-muted me-2">🏢</span> <span class="text-dark fw-medium">@(string.IsNullOrEmpty(adminDepartment) ? "No Department Assigned" : adminDepartment)</span>
                    </div>
                </div>

                <!-- Profile Picture Actions -->
                <div class="d-flex flex-column gap-2">
                    <InputFile id="profilePicUpload" OnChange="HandleImageUpload" class="d-none" accept=".png,.jpg,.jpeg" />
                    <label for="profilePicUpload" class="btn btn-outline-dark btn-sm rounded-pill w-100 fw-semibold py-2" style="cursor: pointer;">
                        📷 Change Photo
                    </label>

                    @if (!string.IsNullOrWhiteSpace(adminProfilePic))
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill w-100 fw-semibold py-2" @onclick="ConfirmAndDeletePhoto">
                            🗑️ Remove Photo
                        </button>
                    }
                </div>

                <small class="text-muted mt-2 d-block" style="font-size: 0.72rem;">Max file size: 2MB - JPG, PNG</small>
            </div>
        </div>

        <!-- Right Column: Personal Information, Security & Summary -->
        <div class="col-lg-8">
            <!-- Personal Information Form Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-1">Personal Information</h5>
                <p class="text-muted small mb-3">Update your personal details and contact information.</p>

                <form @onsubmit="SaveProfileChanges">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Full Name *</label>
                            <input type="text" class="form-control rounded-3 shadow-none" @bind="adminName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Email Address *</label>
                            <input type="email" class="form-control rounded-3 shadow-none bg-light" @bind="adminEmail" readonly />
                            <small class="text-muted" style="font-size: 0.70rem;">Email address cannot be modified directly.</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Department</label>
                            <input type="text" class="form-control rounded-3 shadow-none" @bind="adminDepartment" placeholder="e.g. IT Department" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Role</label>
                            <input type="text" class="form-control rounded-3 shadow-none bg-light" @bind="adminRole" readonly />
                        </div>
                    </div>

                    <button type="submit" class="btn text-white rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #0d3b66;">
                        Save Changes
                    </button>
                </form>
            </div>

            <!-- Security Form Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-1">Security</h5>
                <p class="text-muted small mb-3">Keep your account secure with a strong password.</p>

                <form @onsubmit="ChangePassword">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Current Password</label>
                            <input type="password" class="form-control rounded-3 shadow-none" @bind="currentPassword" placeholder="••••••••" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">New Password</label>
                            <input type="password" class="form-control rounded-3 shadow-none" @bind="newPassword" placeholder="••••••••" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-outline-dark rounded-pill px-4 fw-semibold">
                        Update Password
                    </button>
                </form>
            </div>

            <!-- Account Summary Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-1">Account Summary</h5>
                <p class="text-muted small mb-3">Your account details at a glance.</p>

                <div class="row text-muted small g-3">
                    <div class="col-md-4 border-end">
                        <span class="d-block text-secondary fw-semibold">Member Since</span>
                        <span class="text-dark fw-medium">@(adminCreatedAt == default ? "Sep 14, 2026" : adminCreatedAt.ToString("MMM dd, yyyy"))</span>
                    </div>
                    <div class="col-md-4 border-end ps-md-3">
                        <span class="d-block text-secondary fw-semibold">Last Login</span>
                        <span class="text-dark fw-medium">Today, @DateTime.Now.ToString("hh:mm tt")</span>
                    </div>
                    <div class="col-md-4 ps-md-3">
                        <span class="d-block text-secondary fw-semibold">Account Status</span>
                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill fw-semibold">Active</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int adminId;
    private string adminName = string.Empty;
    private string adminEmail = string.Empty;
    private string adminDepartment = string.Empty;
    private string adminRole = string.Empty;
    private string adminProfilePic = string.Empty;
    private DateTime adminCreatedAt;

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAdminData();
    }

    private async Task LoadAdminData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            adminEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;

            if (int.TryParse(userIdClaim, out adminId))
            {
                var allUsers = await UserService.GetAllUsersAsync();
                var dbUser = allUsers?.FirstOrDefault(u => u.Id == adminId) ?? await UserService.GetUserByEmailAsync(adminEmail);

                if (dbUser != null)
                {
                    adminName = dbUser.Name ?? "Admin";
                    adminEmail = string.IsNullOrEmpty(dbUser.Email) ? adminEmail : dbUser.Email;
                    adminDepartment = dbUser.Department ?? string.Empty;
                    adminRole = string.IsNullOrEmpty(dbUser.Role) ? "Admin" : dbUser.Role;
                    adminCreatedAt = dbUser.CreatedAt;
                    adminProfilePic = dbUser.ProfilePicture ?? string.Empty;
                }
            }
        }
    }

    private string GetAdminInitial() =>
        !string.IsNullOrWhiteSpace(adminName) ? adminName[0].ToString().ToUpper() : "A";

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        var file = e.File;
        if (file != null)
        {
            var maxAllowedSize = 2_097_152; // 2 MB
            if (file.Size > maxAllowedSize)
            {
                errorMessage = "File size exceeds the 2MB limit.";
                return;
            }

            try
            {
                // 1. Ensure target directory exists inside wwwroot
                var folderPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "uploads");
                if (!Directory.Exists(folderPath))
                {
                    Directory.CreateDirectory(folderPath);
                }

                // 2. Clean up previous image file from disk if present
                if (!string.IsNullOrWhiteSpace(adminProfilePic) && adminProfilePic.StartsWith("/uploads/"))
                {
                    var oldFilePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", adminProfilePic.TrimStart('/'));
                    if (File.Exists(oldFilePath))
                    {
                        File.Delete(oldFilePath);
                    }
                }

                // 3. Create unique file name and resolve file path
                var fileName = $"{Guid.NewGuid()}_{file.Name}";
                var filePath = Path.Combine(folderPath, fileName);

                // 4. Save uploaded file to disk
                using (var stream = file.OpenReadStream(maxAllowedSize))
                using (var fs = new FileStream(filePath, FileMode.Create))
                {
                    await stream.CopyToAsync(fs);
                }

                // 5. Update local state and persist relative URL to database
                var relativePath = $"/uploads/{fileName}";
                adminProfilePic = relativePath;

                var dbUser = await UserService.GetUserByEmailAsync(adminEmail);
                if (dbUser != null)
                {
                    dbUser.ProfilePicture = relativePath;
                    await UserService.UpdateUserAsync(dbUser);
                    successMessage = "Profile picture updated successfully!";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error uploading image: {ex.Message}";
            }

            StateHasChanged();
        }
    }

    private async Task ConfirmAndDeletePhoto()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to remove your profile picture?");
        if (confirmed)
        {
            errorMessage = string.Empty;
            successMessage = string.Empty;

            // Remove existing image file from wwwroot/uploads/
            if (!string.IsNullOrWhiteSpace(adminProfilePic) && adminProfilePic.StartsWith("/uploads/"))
            {
                var filePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", adminProfilePic.TrimStart('/'));
                if (File.Exists(filePath))
                {
                    File.Delete(filePath);
                }
            }

            adminProfilePic = string.Empty;

            var dbUser = await UserService.GetUserByEmailAsync(adminEmail);
            if (dbUser != null)
            {
                dbUser.ProfilePicture = null;
                await UserService.UpdateUserAsync(dbUser);
                successMessage = "Profile picture removed successfully!";
            }

            StateHasChanged();
        }
    }

    private async Task SaveProfileChanges()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var dbUser = await UserService.GetUserByEmailAsync(adminEmail);
            if (dbUser != null)
            {
                dbUser.Name = adminName;
                dbUser.Department = adminDepartment;

                await UserService.UpdateUserAsync(dbUser);
                successMessage = "Profile details updated successfully!";
            }
            else
            {
                errorMessage = "Could not locate user record to update.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while saving: {ex.Message}";
        }
    }

    private async Task ChangePassword()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Please fill in both password fields.";
            return;
        }

        try
        {
            var dbUser = await UserService.GetUserByEmailAsync(adminEmail);
            if (dbUser != null)
            {
                dbUser.PasswordHash = newPassword;
                await UserService.UpdateUserAsync(dbUser);

                successMessage = "Password updated successfully!";
                currentPassword = string.Empty;
                newPassword = string.Empty;
            }
            else
            {
                errorMessage = "Could not verify user account for password update.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating password: {ex.Message}";
        }
    }
}