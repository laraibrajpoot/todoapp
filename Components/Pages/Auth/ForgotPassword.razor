@page "/forgot-password"
@page "/forgot-password/reset-password"
@layout todolist.Components.Layout.AuthLayout
@rendermode InteractiveServer
@inject todolist.Services.UserService UserService
@inject NavigationManager Navigation

<PageTitle>Forgot Password - TaskFlow</PageTitle>

<style>
    /* Left panel with the spiral background matching login */
    .auth-left {
        position: relative;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 50%, #1e40af 100%);
        overflow: hidden;
        padding: 0;
        display: flex;
        flex-direction: row;   /* Added: resets column flow from auth.css */
        justify-content: center;
        align-items: center;
        width: 50%;
        min-height: 100vh;
    }

        /* Decorative Spiral / Wave background lines */
        .auth-left::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background-image: repeating-radial-gradient( circle at 0% 50%, transparent, transparent 30px, rgba(255, 255, 255, 0.04) 30px, rgba(255, 255, 255, 0.04) 60px );
            transform: rotate(25deg);
            pointer-events: none;
        }

        .auth-left::after {
            content: "";
            position: absolute;
            bottom: -20px;
            left: -20px;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

    /* Wrapper set to full height and width */
    .illustration-wrapper {
        width: 100%;
        height: 100%;
        flex: 1;                /* Added: allows wrapper to expand edge-to-edge */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1;
    }

    /* Stretches the image to fill top and bottom completely while keeping width intact */
    .auth-illustration-img {
        width: 100%;
        height: 100%;
        object-fit: fill;
        border-radius: 0;
        filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.35));
    }

    /* Custom Theme overrides */
    .btn-navy-primary {
        background-color: #0d3b66 !important;
        border-color: #0d3b66 !important;
        color: #ffffff !important;
        font-weight: 600;
    }

        .btn-navy-primary:hover {
            background-color: #092c4d !important;
            border-color: #092c4d !important;
        }
</style>

<div class="auth-page">
    <!-- Left Panel with Stretched Height Image and Spiral Background -->
    <div class="auth-left">
        <div class="illustration-wrapper">
            <img src="/images/sidebarpic.png" alt="TaskFlow Illustration" class="auth-illustration-img" />
        </div>
    </div>

    <div class="auth-right">
        <div class="login-card">
            <h2>@(HasResetToken ? "Set New Password" : "Reset Password")</h2>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">@successMessage</div>
            }

            @if (HasResetToken)
            {
                <form @onsubmit="HandleResetPassword">
                    <div class="form-group mb-3">
                        <label>New Password</label>
                        <input type="password" class="form-control" @bind="newPassword" placeholder="Enter new password" required />
                    </div>
                    <div class="form-group mb-3">
                        <label>Confirm Password</label>
                        <input type="password" class="form-control" @bind="confirmPassword" placeholder="Confirm new password" required />
                    </div>
                    <button type="submit" disabled="@isProcessing" class="login-btn btn btn-primary w-100 btn-navy-primary">
                        @(isProcessing ? "Updating..." : "Save New Password")
                    </button>
                    <p class="signup-link" style="text-align: center; margin-top: 20px; font-size: 0.9rem;">
                        Back to <a href="/login" style="color: #0d3b66; font-weight: 600;">Sign In</a>
                    </p>
                </form>
            }
            else
            {
                <form @onsubmit="HandlePasswordResetRequest">
                    <div class="form-group mb-3">
                        <label>Email Address</label>
                        <input type="email" class="form-control" @bind="email" placeholder="Enter your email" required />
                    </div>
                    <button type="submit" disabled="@isProcessing" class="login-btn btn btn-primary w-100 btn-navy-primary">
                        @(isProcessing ? "Sending Link..." : "Send Reset Link")
                    </button>
                    <p class="signup-link" style="text-align: center; margin-top: 20px; font-size: 0.9rem;">
                        Remembered your password? <a href="/login" style="color: #0d3b66; font-weight: 600;">Sign In</a>
                    </p>
                </form>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private bool HasResetToken => !string.IsNullOrEmpty(Token) && !string.IsNullOrEmpty(Email);

    private string email = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isProcessing = false;

    private async Task HandlePasswordResetRequest()
    {
        isProcessing = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/') + "/forgot-password";
            var (success, error) = await UserService.RequestPasswordResetAsync(email, baseUrl);

            if (success)
            {
                successMessage = "If an account exists with this email, password reset instructions have been sent.";
                email = string.Empty;
            }
            else
            {
                errorMessage = error ?? "Failed to send reset email. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.GetType().Name} - {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleResetPassword()
    {
        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isProcessing = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var (success, error) = await UserService.ResetPasswordAsync(Email!, Token!, newPassword);

            if (success)
            {
                successMessage = "Your password has been successfully reset. Redirecting to login...";
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = error ?? "Invalid or expired reset link. Please request a new one.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.GetType().Name} - {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}